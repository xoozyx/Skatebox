{
  "rules": {
    ".read": false,
    ".write": false,
    "slots": {
      ".read": "auth != null",
      "$n": {
        ".write": "auth != null && $n.matches(/^([0-9]|1[0-9]|2[0-4])$/) && (!data.exists() || data.val() === auth.uid) && (!newData.exists() || newData.val() === auth.uid)",
        ".validate": "newData.isString()"
      }
    },
    "players": {
      "$loc": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['n', 'o', 'd', 's']) && root.child('slots').child(newData.child('s').val() + '').val() === auth.uid",
          "n": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "o": { ".validate": "newData.isString() && newData.val().length <= 24" },
          "d": { ".validate": "newData.isString() && newData.val().length <= 160" },
          "s": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 25" },
          "$other": { ".validate": false }
        }
      }
    },
    "kickers": {
      "$loc": {
        ".read": "auth != null",
        "$id": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['x', 'y', 'd', 'c'])",
          "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2000" },
          "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2000" },
          "d": { ".validate": "newData.isNumber() && (newData.val() === 1 || newData.val() === -1)" },
          "c": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
